PORT=3000
HOST_PORT=80
NODE_ENV=development

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_DEBUG=false

CONTACT_TO=your_destination_email@example.com
CORS_ORIGIN=

CONTACT_RATE_WINDOW_MS=900000
CONTACT_RATE_MAX=5
CONTACT_MAX_FIELD_LENGTH=200
CONTACT_MAX_MESSAGE_LENGTH=5000
